<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="market-scope docs" version="24.0.0"><diagram name="system" id="system"><mxGraphModel dx="900" dy="510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="510" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="shared" value="packages/shared&lt;br&gt;boundary maths, file contract, constants — imported by API and web alike" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="530" height="44" as="geometry"/></mxCell><mxCell id="note" value="Deployed: the browser calls the API directly&lt;br&gt;(NEXT_PUBLIC_API_URL); the worker is its own&lt;br&gt;process (JOBS=off on the API). Locally one&lt;br&gt;process does both; the web server proxies /api." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="280" height="76" as="geometry"/></mxCell><mxCell id="web" value="Web server&lt;br&gt;next (3200)&lt;br&gt;serves pages; proxies /api locally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="browser" value="Browser&lt;br&gt;Next.js app (React, Leaflet)&lt;br&gt;upload · setup · dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="200" height="70" as="geometry"/></mxCell><mxCell id="osm" value="OpenStreetMap tiles&lt;br&gt;map images, straight to the browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="60" as