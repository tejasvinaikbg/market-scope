<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="market-scope docs" version="24.0.0"><diagram name="pipeline" id="pipeline"><mxGraphModel dx="1000" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="create" value="POST /api/markets&lt;br&gt;validate · measure with PostGIS&lt;br&gt;insert market + queue job (one transaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="280" height="70" as="geometry"/></mxCell><mxCell id="claim" value="Worker claims the job&lt;br&gt;FOR UPDATE SKIP LOCKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="280" height="56" as="geometry"/></mxCell><mxCell id="geo" value="1 · Locate&lt;br&gt;portfolio rows without coordinates,&lt;br&gt;inside the city box (Nominatim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="280" height="66" as="geometry"/></mxCell><mxCell id="place" value="2 · Place&lt;br&gt;every portfolio store: inside · outside · unlocated&lt;br&gt;(ST_Covers, one statement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="280" height="66" as="geometry"/></mxCell><mxCell id="disc" value="3 · Discover&lt;br&gt;grid cells over the boundary → tile cache or Overpass&lt;br&gt;keep what lies inside · upsert · progress per cell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="300" height="70" as="geometry"/></mxCell><mxCell id="match" value="4 · Match&lt;br&gt;nearest discovered store, same category,&lt;br&gt;within 150 m (ST_DWithin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="370" width="300" height="66" as="geometry"/></mxCell><mxCell id="done" value="Status&lt;br&gt;ready · partial (some cells failed) · failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="480" width="300" height="56" as="geometry"/></mxCell><mxCell id="dash" value="Dashboard&lt;br&gt;polls the market every 2 s while it runs;&lt;br&gt;reads the stores list when it ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="250" height="70" as="geometry"/></mxCell><mxCell id="note" value="Every step rewrites its own rows, so a run&lt;br&gt;can be repeated safely: &quot;run again&quot;, an&lt;br&gt;edit, or a job taken over after a worker died." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="40" width="250" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="create" target="claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="claim" target="geo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="geo" target="place"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="place" target="disc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="disc" target="match"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="match" target="done"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="status, counts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="done" target="dash"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="508"/><mxPoint x="690" y="295"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>