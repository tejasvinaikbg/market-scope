<mxfile host="app.diagrams.net" modified="2026-09-06T00:00:00.000Z" agent="market-scope docs" version="24.0.0"><diagram name="prod-10m" id="prod-10m"><mxGraphModel dx="1090" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1090" pageHeight="500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="edge" value="Global edge&lt;br&gt;CDN · WAF · per-tenant rate rules · static web · map tiles proxied and cached · SSE routed to the push tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1030" height="44" as="geometry"/></mxCell><mxCell id="auth" value="Identity&lt;br&gt;authentication, tenants,&lt;br&gt;per-tenant quotas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="api" value="API tier, per region&lt;br&gt;autoscaled, stateless&lt;br&gt;reads go to the region&#x27;s replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="240" height="70" as="geometry"/></mxCell><mxCell id="push" value="Status push&lt;br&gt;SSE gateway tier or a push service&lt;br&gt;(Ably, AppSync); notify when the queue is deep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="260" height="70" as="geometry"/></mxCell><mxCell id="broker" value="Broker&lt;br&gt;SQS or BullMQ on Redis&lt;br&gt;jobs table as the outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="190" height="90" as="geometry"/></mxCell><mxCell id="replicas" value="Read replicas&lt;br&gt;per region" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="220" height="90" as="geometry"/></mxCell><mxCell id="pg" value="Postgres, partitioned&lt;br&gt;by tenant / market id&lt;br&gt;primary per region" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="240" height="100" as="geometry"/></mxCell><mxCell id="workers" value="Worker pools by job type&lt;br&gt;geocode · discover · match&lt;br&gt;scaled on queue depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="250" width="260" height="70" as="geometry"/></mxCell><mxCell id="cache" value="Tile cache in Redis&lt;br&gt;cell answers served hot;&lt;br&gt;Postgres keeps the durable copy" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="s3" value="Object storage&lt;br&gt;uploads straight from the&lt;br&gt;browser (presigned) · exports" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="220" height="90" as="geometry"/></mxCell><mxCell id="events" value="Event stream (Kafka / SNS)&lt;br&gt;&quot;market discovered&quot; and the like&lt;br&gt;for other systems and analytics" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="240" height="90" as="geometry"/></mxCell><mxCell id="geo" value="Geo service&lt;br&gt;self-hosted Overpass + Nominatim per region,&lt;br&gt;nightly extracts; Google as a paid fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="380" width="260" height="70" as="geometry"/></mxCell><mxCell id="note" value="What never changes: routes,&lt;br&gt;services, queries, providers,&lt;br&gt;screens. Every box here is&lt;br&gt;infrastructure placed around&lt;br&gt;them when its trigger is met." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="870" y="380" width="190" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="edge" target="auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="100"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="edge" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="100"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="auth" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="api" target="replicas"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y=