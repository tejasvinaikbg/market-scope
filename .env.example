# Postgres (Docker)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name
POSTGRES_PORT=5432
DATABASE_URL=postgres://user:password@localhost:5432/db_name
# API
PORT=4200
LOG_LEVEL=info

# Geocoding: nominatim (live, free) or fixture (offline, from apps/api/fixtures/geocode.json)
GEOCODER=nominatim
NOMINATIM_USER_AGENT=market-scope/0.1 (your-email@example.com)

# Data sources. Every provider has a switch: off means greyed out on the setup screen and refused by the API.
# The Google ones also need a key; without one they show as "not configured" whatever the switch says.
OVERPASS_ENABLED=true
NOMINATIM_ENABLED=true
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=true
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_ENABLED=true