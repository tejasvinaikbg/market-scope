# Postgres (Docker)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name
POSTGRES_PORT=5432
DATABASE_URL=postgres://user:password@localhost:5432/db_name
# The route tests' own Postgres container (`npm run db:test:up`): same image, no volume, never pointed at by a server
POSTGRES_TEST_DB=db_name_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgres://user:password@localhost:5433/db_name_test
# API
PORT=4200
LOG_LEVEL=info

# Address lookup: live (OSM Nominatim or Google Geocoding, as each market chooses) or fixture (offline, from apps/api/fixtures/geocode.json)
GEOCODER=live
NOMINATIM_USER_AGENT=market-scope/0.1 (you@your-domain.com)   # a real address: the OSM mirrors answer 406 to placeholders like example.com

# Scale knobs (defaults suit local; raise or set when deployed — see docs/reference/deployment-plan.md)
DB_POOL_MAX=10
TILE_CACHE_HOURS=24
# Matching: a portfolio store and a discovered store of the same category within this many metres are the same shop
MATCH_DISTANCE_M=150
JOB_STALE_MINUTES=15
TRUST_PROXY=0
CORS_ORIGIN=
RATE_LIMIT_PER_MINUTE=300
# Web, at build time: the API's own URL when the browser should call it directly (deployed); blank = the Next rewrite proxy (local)
NEXT_PUBLIC_API_URL=

# Background jobs: on = this API process also runs discovery (local default); off = an API instance that only answers,
# with `npm run worker -w apps/api` running the queue as its own process (the deployed shape).
JOBS=on

# Store discovery: live (OSM Overpass or Google Places, as each market chooses) or fixture (offline, from apps/api/fixtures/overpass.json)
PLACES=live
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Data sources. Every provider has a switch: off means greyed out on the setup screen and refused by the API.
# The Google ones also need a key; without one they show as "not configured" whatever the switch says.
OVERPASS_ENABLED=true
NOMINATIM_ENABLED=true
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_ENABLED=false
# Web, at build time: the browser key for the Google map (Maps JavaScript API, restricted by website); blank = the OpenStreetMap map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
