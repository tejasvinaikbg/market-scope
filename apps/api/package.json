{
  "name": "api",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "LOG_LEVEL=silent tsx --test \"src/**/*.test.ts\"",
    "test:integration": "LOG_LEVEL=silent tsx --test \"test/**/*.test.ts\"",
    "knex": "NODE_OPTIONS=--import=tsx knex --knexfile src/db/knexfile.ts",
    "migrate": "npm run knex -- migrate:latest",
    "migrate:up": "npm run knex -- migrate:up",
    "migrate:down": "npm run knex -- migrate:down",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:status": "npm run knex -- migrate:status",
    "migrate:make": "npm run knex -- migrate:make -x ts",
    "seed:make": "npm run knex -- seed:make -x ts",
    "seed:run": "npm run knex -- seed:run"
  },
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}